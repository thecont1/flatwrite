{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flatwrite",
  "main": "worker/index.js",
  "build": {
    "command": "bun scripts/vendor-extract-assets.mjs"
  },
  "compatibility_date": "2026-06-24",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    // SPA fallback: unknown paths serve /index.html with 200 (navigation
    // requests), matching the Vercel deployment's `/* /index.html 200`
    // proxy rule from public/_redirects.
    "not_found_handling": "single-page-application",
    // Only API paths invoke the Worker; every other request is served
    // directly by the static assets layer (with _redirects/_headers
    // processing), without a Worker invocation.
    "run_worker_first": ["/api/*"]
  },
  // nodejs_compat (compat date >= 2025-04-01 auto-populates process.env with
  // Worker env vars/secrets) is required by api/render.js, api/fetch-document.js,
  // api/import-url.js and core/*: node:crypto, node:dns, node:net,
  // node:module (createRequire), plus Buffer. Secrets/vars to configure:
  //   INTERNAL_RENDER_KEY  — HMAC secret for /api/render (same as Vercel)
  //   DUSTEBIN_BASE_URL    — paste bin base URL for /api/share + /api/s
  // Conversion is browser-local or in-process in the extract Worker; no
  // upstream extract-service secrets are used here.
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
