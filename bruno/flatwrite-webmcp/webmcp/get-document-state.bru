meta {
  name: WebMCP get_document_state (browser only)
  type: http
  seq: 10
  tags: [webmcp, browser-only, webmcp-side-effect]
  webmcp-type: webmcp-side-effect
}

post {
  url: webmcp://document.modelContext/get-document-state
  body: none
  auth: none
}

script:pre-request {
  bru.runner.skipRequest();
}

docs {
  Browser-only WebMCP contract. This tool manipulates the FlatWrite editor via
  document.modelContext and has no HTTP surface. Bruno CLI skips this request.

  Input: {}
  Output: { ok, documentId, title, wordCount, unsavedChanges, url, charCount?, renderMode?, docEngine?, surfaceMode?, availableExports?, canShare? }
}
