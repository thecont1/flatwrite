meta {
  name: WebMCP open_document (browser only)
  type: http
  seq: 12
  tags: [webmcp, browser-only, webmcp-side-effect]
  webmcp-type: webmcp-side-effect
}

post {
  url: webmcp://document.modelContext/open-document
  body: none
  auth: none
}

script:pre-request {
  bru.runner.skipRequest();
}

docs {
  Browser-only WebMCP contract. This tool manipulates the FlatWrite editor via
  document.modelContext and has no HTTP surface. Bruno CLI skips this request.

  Input: { url: string }
  Output: { ok, documentId, title, url, active, nextSuggestedTool? }
}
