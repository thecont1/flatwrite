meta {
  name: Assist document (POST /assist)
  type: http
  seq: 1
  tags: [assist]
}

post {
  url: {{assistBaseUrl}}/assist
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Api-Key: {{apiKey}}
}

body:json {
  {
    "mode": "fix_grammar",
    "markdown": "# Draft\n\nTeh quick brown fox."
  }
}

script:post-response {
  if (res.getStatus() === 429) {
    const retryAfter = res.getHeader('retry-after');
    if (retryAfter != null) {
      bru.setVar('retryAfter', String(retryAfter));
      bru.setVar('retryAfterSetAt', String(Date.now()));
    }
  }
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("response matches assist output envelope", function() {
    const body = res.getBody();
    expect(body.ok).to.equal(true);
    expect(body.markdown).to.be.a('string');
    expect(body.piece).to.be.a('string');
    expect(['selection', 'document']).to.include(body.scope);
  });
}
