meta {
  name: Extract file (POST /extract)
  type: http
  seq: 1
  tags: [extract]
}

post {
  url: {{extractBaseUrl}}/extract
  body: multipartForm
  auth: none
}

headers {
  X-Api-Key: {{apiKey}}
}

body:multipart-form {
  file: @file({{sampleFile}})
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("response has markdown and metadata", function() {
    const body = res.getBody();
    expect(body).to.have.property('markdown').that.is.a('string');
    expect(body).to.have.property('metadata').that.is.an('object');
    expect(body.metadata).to.have.property('filename').that.is.a('string');
    expect(body.metadata).to.have.property('fileType').that.is.a('string');
    expect(body.metadata).to.have.property('extractionType').that.is.a('string');
    expect(body.metadata).to.have.property('sizeBytes').that.is.a('number');
  });
}

docs {
  Uploads one allowlisted file. sampleFile is environment-configurable and
  defaults to the committed bruno/fixtures/sample.md fixture.
}
