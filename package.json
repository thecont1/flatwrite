{
  "name": "flatwrite",
  "version": "1.0.0",
  "license": "AGPL-3.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "dev": "bunx serve .",
    "start": "node public/server.js",
    "test": "bun test ./test/*.test.js",
    "test:e2e": "playwright test",
    "test:e2e:live-import": "FW_E2E_LIVE_IMPORT=1 playwright test test/e2e/import-url.spec.js",
    "test:py": "cd services/extract && uv run --project . pytest ../../test/extract",
    "test:all": "bun test ./test/*.test.js && cd services/extract && uv run --project . pytest ../../test/extract",
    "deploy": "wrangler deploy",
    "preview": "wrangler dev",
    "bruno:import": "rm -rf bruno/.openapi-import && mkdir -p bruno && bru import openapi --source openapi.yaml --output bruno/.openapi-import --collection-name \"FlatWrite API\" --collection-format bru --group-by tags",
    "bruno:run:api": "cd bruno/flatwrite-api && bru run --env ${BRUNO_ENV:-Render} -r",
    "bruno:run:webmcp": "cd bruno/flatwrite-webmcp && bru run --env ${BRUNO_ENV:-Production} -r",
    "bruno:lint": "node bruno/scripts/validate-collections.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@usebruno/cli": "^4.0.0",
    "bun-types": "^1.3.14",
    "js-yaml": "^4.1.0",
    "wrangler": "^4.104.0"
  },
  "dependencies": {
    "chrome-devtools-mcp": "^1.4.0",
    "marked": "14.1.4",
    "sanitize-html": "^2.17.5",
    "spectrum-ts": "^5.2.0"
  }
}
